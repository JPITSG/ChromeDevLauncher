// Chrome Developer Launcher - Windows Resource File

#include "version.h"

1 VERSIONINFO
FILEVERSION APP_VERSION_RESOURCE
PRODUCTVERSION APP_VERSION_RESOURCE
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "JPIT\0"
            VALUE "FileDescription", "Chrome Developer Launcher\0"
            VALUE "FileVersion", APP_FILE_VERSION_STRING "\0"
            VALUE "InternalName", "ChromeDevLauncher\0"
            VALUE "OriginalFilename", "ChromeDevLauncher.exe\0"
            VALUE "ProductName", "Chrome Developer Launcher\0"
            VALUE "ProductVersion", APP_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

// Icon resource (ID 101 = IDI_TRAYICON)
101 ICON "assets/icon.ico"

// WebView2 UI resources
200 RCDATA "assets/dist/index.html"
201 RCDATA "assets/WebView2Loader.dll"
